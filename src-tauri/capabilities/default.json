{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for DSHDesktop windows",
  "windows": ["main", "diagnostics"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "notification:default",
    "autostart:default",
    "allow-get-status",
    "allow-restart-dsh",
    "allow-get-recent-logs",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-bootstrap-error",
    "allow-is-first-launch",
    "allow-zoom-ui"
  ]
}
