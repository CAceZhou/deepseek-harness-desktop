{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for DSHDesktop windows",
  "windows": ["main", "diagnostics", "settings", "skills", "mcp"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "notification:default",
    "autostart:default",
    "allow-get-status",
    "allow-restart-dsh",
    "allow-get-recent-logs",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-bootstrap-error",
    "allow-is-first-launch",
    "allow-zoom-ui",
    "allow-get-shell-settings",
    "allow-set-shell-settings",
    "allow-preview-completion-sound",
    "allow-list-skills",
    "allow-list-import-sources",
    "allow-import-skills",
    "allow-set-skill-enabled",
    "allow-delete-skill",
    "allow-list-mcp-servers",
    "allow-upsert-mcp-server",
    "allow-set-mcp-enabled",
    "allow-delete-mcp-server",
    "allow-list-mcp-import-sources",
    "allow-import-mcp-servers"
  ]
}
